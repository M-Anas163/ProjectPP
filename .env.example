DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/parproject

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_ISOLATION_LEVEL=READ COMMITTED
DB_TRANSACTION_RETRIES=3

MAX_CONCURRENT_REQUESTS=20
FINANCE_CHECKOUT_CONCURRENCY=8
FINANCE_CHECKOUT_RATE_LIMIT=6000

ASYNC_WORKERS=2
PERFORMANCE_LOG_SAMPLE_RATE=0.1
PERFORMANCE_LOG_QUEUE_SIZE=1000

# Use only for disposable local databases. Production schema changes must use migrations.
AUTO_CREATE_SCHEMA=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
